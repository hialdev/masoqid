---
import WhatsAppButton from "./WhatsAppButton.astro";
import { translations } from "../i18n/translations";

const features = translations.id.pricing.features;
---

<section
   class="py-24 bg-gradient-to-br from-blue-600 to-blue-800 text-white relative overflow-hidden"
   id="pricing"
>
   <div
      class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none"
      style="background-image: linear-gradient(45deg, #000 25%, transparent 25%, transparent 50%, #000 50%, #000 75%, transparent 75%, transparent); background-size: 64px 64px;"
   >
   </div>

   <div
      class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col items-center"
   >
      <div class="text-center mb-10">
         <h2
            class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
            data-i18n="pricing.title"
         >
            Harga Simpel & Transparan
         </h2>
         <p class="mt-4 text-lg text-white" data-i18n="pricing.subtitle">
            Solusi enterprise dengan harga startup.
         </p>
      </div>

      <div
         class="bg-white rounded-2xl shadow-2xl p-8 max-w-lg w-full transform transition hover:scale-105 duration-300"
      >
         <div class="flex justify-between items-center mb-6">
            <div>
               <h3
                  class="text-xl font-bold text-gray-900"
                  data-i18n="pricing.card_title"
               >
                  Standard Plan
               </h3>
               <p class="text-sm text-gray-600" data-i18n="pricing.card_desc">
                  Semua yang Anda butuhkan untuk memulai
               </p>
            </div>
            <div
               class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"
               data-i18n="pricing.badge"
            >
               Paling Populer
            </div>
         </div>

         <div class="flex items-baseline mb-6 border-b border-gray-100 pb-6">
            <span class="text-5xl font-extrabold text-blue-600">IDR 10.000</span
            >
            <span class="text-lg text-gray-600 ml-2" data-i18n="pricing.unit"
               >/karyawan/bulan</span
            >
         </div>

         <ul class="space-y-4 mb-8">
            {
               features.map((feature, index) => (
                  <li class="flex items-center gap-3">
                     <span class="material-symbols-outlined text-emerald-600">
                        check_circle
                     </span>
                     <span
                        class="text-sm text-gray-900"
                        data-i18n={`pricing.features.${index}`}
                     >
                        {feature}
                     </span>
                  </li>
               ))
            }
         </ul>

         <WhatsAppButton
            text="Pilih Paket"
            variant="full"
            i18nKey="pricing.cta"
         />
      </div>
   </div>
</section>
