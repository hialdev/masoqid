---
import WhatsAppButton from "./WhatsAppButton.astro";
---

<div
   id="sticky-plan"
   class="fixed bottom-0 left-0 w-full z-40 transform transition-transform duration-500 translate-y-full"
>
   <div
      class="relative bg-gradient-to-r to-blue-400/40 from-blue-50/60 backdrop-blur-md border-t border-blue-600/20 px-4 py-4 md:px-8"
   >
      <!-- Certificate Badge -->
      <div
         class="absolute -top-5 left-4 md:left-8 bg-white rounded-full p-1.5 shadow-lg border border-blue-100 flex items-center justify-center z-50 transform hover:scale-110 transition-transform"
         title="Official Partner"
      >
         <span class="material-symbols-outlined text-yellow-500 text-2xl"
            >workspace_premium</span
         >
      </div>
      <div
         class="max-w-7xl mx-auto flex w-full flex-col md:flex-row items-center justify-between gap-4"
      >
         <!-- Left Side: Plan Info -->
         <div class="flex w-full items-center gap-4">
            <div class="text-left">
               <h3
                  class="font-bold text-gray-900 text-lg"
                  data-i18n="sticky.plan"
               >
                  Standard Plan
               </h3>
               <p
                  class="text-sm text-blue-600 font-medium"
                  data-i18n="sticky.price"
               >
                  IDR 10.000/karyawan/bulan
               </p>
            </div>

            <!-- Right Side: Buttons -->
            <div class="flex items-center justify-end gap-3 w-full">
               <a
                  href="#demo"
                  onclick="document.getElementById('demo-form')?.querySelector('input')?.focus()"
                  class="flex-1 md:flex-none text-center px-4 py-2 border border-blue-600 text-blue-600 font-medium rounded-lg hover:bg-blue-50 transition-colors text-sm"
                  data-i18n="sticky.demo"
               >
                  Coba Demo
               </a>
               <WhatsAppButton
                  text="Hubungi Kami"
                  variant="primary"
                  i18nKey="sticky.contact"
                  className="flex-1 md:flex-none justify-center text-sm py-2"
               />
            </div>
         </div>
      </div>
   </div>

   <script>
      const stickyBar = document.getElementById("sticky-plan");
      const pricingSection = document.getElementById("pricing");
      let isPricingVisible = false;
      let idleTimeout: any;

      // Function to show/hide
      function showBar() {
         if (!stickyBar) return;
         stickyBar.classList.remove("translate-y-full");
      }

      function hideBar() {
         if (!stickyBar) return;
         stickyBar.classList.add("translate-y-full");
      }

      // 1. Check Pricing Visibility
      if (pricingSection) {
         const observer = new IntersectionObserver(
            (entries) => {
               entries.forEach((entry) => {
                  isPricingVisible = entry.isIntersecting;

                  if (isPricingVisible) {
                     hideBar(); // Close immediately if pricing visible
                  } else {
                     // If we just scrolled out of pricing, triggers scroll event anyway logic below handles it
                  }
               });
            },
            { threshold: 0.1 }, // 10% visible
         );
         observer.observe(pricingSection);
      }

      // 2. Scroll & Idle Logic
      function handleScroll() {
         // Logic: "muncul... jika ada scroll"
         if (window.scrollY < 100) {
            hideBar();
            return; // Don't show at very top
         }

         if (isPricingVisible) {
            hideBar();
            return;
         }

         // If not pricing visible, show bar
         showBar();

         // Reset Idle Timer
         clearTimeout(idleTimeout);
         idleTimeout = setTimeout(() => {
            // Slide down after 4s idle
            // Logic: "jika sudah idle 4 detik maka slide down pudar"
            // (pudar handled by transition visually, slide down handled by translate-y-full)
            hideBar();
         }, 4000);
      }

      window.addEventListener("scroll", handleScroll, { passive: true });
   </script>
</div>
