---
import WhatsAppButton from "./WhatsAppButton.astro";
import LanguageSwitcher from "./LanguageSwitcher";
---

<nav
   class="sticky bg-white text-gray-900 top-0 z-50 w-full border-b border-[#e7ebf3] bg-background-light/95 backdrop-blur"
>
   <div
      class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
   >
      <div class="flex items-center gap-2">
         <img src="/logo.png" alt="MASOQ.id" class="h-8" />
      </div>
      <div class="hidden md:flex items-center gap-8">
         <a
            class="text-sm font-medium transition-colors"
            href="#features"
            data-i18n="nav.features">Fitur</a
         >
         <a
            class="text-sm font-medium transition-colors"
            href="#advantages"
            data-i18n="nav.advantages">Keunggulan</a
         >
         <a
            class="text-sm font-medium transition-colors"
            href="#pricing"
            data-i18n="nav.pricing">Harga</a
         >
         <a
            class="text-sm font-medium transition-colors"
            href="#contact"
            data-i18n="nav.contact">Kontak</a
         >
      </div>
      <div class="flex items-center gap-4">
         <LanguageSwitcher client:load className="hidden sm:block" />
         <WhatsAppButton text="Mulai Sekarang" i18nKey="nav.start" />
      </div>
   </div>
</nav>
