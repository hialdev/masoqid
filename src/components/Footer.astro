---
import WhatsAppButton from "./WhatsAppButton.astro";
import LanguageSwitcher from "./LanguageSwitcher";
---

<footer
   class="bg-background-light border-t border-gray-200 pt-16 pb-8"
   id="contact"
>
   <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
         class="flex flex-col md:flex-row justify-between items-start gap-12 mb-12"
      >
         <!-- Brand Section -->
         <div class="max-w-md">
            <div class="flex items-center gap-2 mb-4">
               <img src="/logo.png" alt="MASOQ.id" class="h-6" />
            </div>
            <p
               class="text-text-muted text-sm leading-relaxed mb-6"
               data-i18n="footer.desc"
            >
               Membuat absensi jujur, mudah, dan cerdas. Kami membantu
               perusahaan mengurangi penipuan dan meningkatkan produktivitas
               dengan validasi cerdas.
            </p>
            <div class="flex gap-4">
               <a
                  class="text-gray-400 hover:text-primary transition-colors"
                  href="#"
                  aria-label="LinkedIn"
               >
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
                     ><path
                        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                     ></path></svg
                  >
               </a>
               <a
                  class="text-gray-400 hover:text-primary transition-colors"
                  href="#"
                  aria-label="Instagram"
               >
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
                     ><path
                        d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                     ></path></svg
                  >
               </a>
            </div>
         </div>

         <!-- Contact Section -->
         <div class="flex flex-col gap-4">
            <h3
               class="text-sm font-bold uppercase tracking-wider text-text-main"
               data-i18n="footer.contact"
            >
               Hubungi Kami
            </h3>
            <div class="flex flex-col gap-3">
               <a
                  class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors"
                  href="tel:08111892842"
               >
                  <span class="material-symbols-outlined text-lg">call</span>
                  <span>08111892842</span>
               </a>
               <a
                  class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors"
                  href="mailto:hello@masoq.id"
               >
                  <span class="material-symbols-outlined text-lg">mail</span>
                  <span>hello@masoq.id</span>
               </a>
               <div class="flex items-center gap-2 text-text-muted">
                  <span class="material-symbols-outlined text-lg"
                     >location_on</span
                  >
                  <span>Jakarta, Indonesia</span>
               </div>
            </div>
         </div>

         <!-- CTA Section -->
         <div class="flex flex-col gap-4 min-w-[200px]">
            <h3
               class="text-sm font-bold uppercase tracking-wider text-text-main"
               data-i18n="footer.discuss"
            >
               Mari Diskusi
            </h3>
            <p
               class="text-sm text-text-muted mb-2"
               data-i18n="footer.discuss_desc"
            >
               Siap mengamankan sistem absensi Anda?
            </p>
            <WhatsAppButton
               text="Hubungi Kami"
               variant="full"
               className="shadow-none py-2"
               i18nKey="footer.contact"
            />
         </div>
      </div>

      <!-- Bottom Bar -->
      <div
         class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
      >
         <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8">
            <p class="text-sm text-gray-400">
               © 2026 MASOQ.id. All rights reserved.
            </p>
            <LanguageSwitcher client:load direction="up" />
