---

---

<section class="py-24 bg-gray-50 overflow-hidden" id="demo">
   <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
         <!-- Left Column: Content & Form -->
         <div class="text-center lg:text-left">
            <h2
               class="text-3xl font-bold tracking-tight text-text-main sm:text-4xl mb-4"
               data-i18n="demo.title"
            >
               Coba Rasakan Pengalamannya Langsung!
            </h2>
            <p
               class="text-lg text-text-muted mb-8 max-w-2xl mx-auto lg:mx-0"
               data-i18n="demo.desc"
            >
               Anda masih ragu? Berikan kami email atau nomor telepon Anda, dan
               kami akan memberikan demo sistem absensi cerdas kami!
            </p>

            <form
               id="demo-form"
               class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto lg:mx-0"
            >
               <input
                  type="text"
                  name="contact"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
                  placeholder="Email / Nomor Telepon"
                  data-i18n-placeholder="demo.placeholder"
               />
               <button
                  type="submit"
                  class="w-full sm:w-auto px-8 py-3 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 active:translate-y-0"
                  data-i18n="demo.submit"
               >
                  Coba Demo
               </button>
            </form>
         </div>

         <!-- Right Column: Laptop Mockup & Slider -->
         <div class="relative mt-8 lg:mt-0 px-4 sm:px-0">
            <!-- Laptop/Macbook Frame Styling -->
            <div
               class="relative mx-auto rounded-xl bg-gray-900 shadow-2xl overflow-hidden max-w-[600px] border-[10px] border-gray-800"
            >
               <!-- Screen Content -->
               <div
                  class="aspect-[16/10] bg-white relative overflow-hidden"
                  id="demo-slider"
               >
                  <!-- Images -->
                  <div
                     class="slider-track flex transition-transform duration-700 ease-in-out h-full"
                  >
                     <img
                        src="/mockup-1.png"
                        alt="Dashboard Demo 1"
                        class="w-full h-full object-contain bg-white shrink-0"
                     />
                     <img
                        src="/mockup-2.png"
                        alt="Dashboard Demo 2"
                        class="w-full h-full object-contain bg-white shrink-0"
                     />
                     <img
                        src="/mockup-3.png"
                        alt="Dashboard Demo 3"
                        class="w-full h-full object-contain bg-white shrink-0"
                     />
                  </div>
               </div>

               <!-- Camera Dot -->
               <div
                  class="absolute top-0 left-1/2 -translate-x-1/2 h-2 w-20 bg-gray-800 rounded-b-xl z-20 flex items-center justify-center"
               >
                  <div class="h-1 w-1 bg-gray-700 rounded-full"></div>
               </div>
            </div>

            <!-- Simple Laptop Base Reflection/Shadow -->
            <div
               class="mx-auto h-4 max-w-[650px] bg-gray-300 mt-1 rounded-b-lg opacity-40 blur-sm"
            >
            </div>
         </div>
      </div>
   </div>
</section>

<style>
   /* Hide scrollbar for slider if any */
   .slider-track {
      width: 100%;
   }
</style>

<script>
   // Form Logic
   const form = document.getElementById("demo-form");
   if (form) {
      form.addEventListener("submit", (e) => {
         e.preventDefault();
         const input = (
            form.querySelector('input[name="contact"]') as HTMLInputElement
         ).value;

         if (input.length < 3) return;

         // Redirect to WhatsApp
         const phoneNumber = "628111892842";
         const message = `Hallo, Saya ${input} tertarik untuk demo aplikasi Masoq.id`;
         const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;

         window.open(url, "_blank");
      });
   }

   // Placeholder Translation
   function updatePlaceholders() {
      const inputs = document.querySelectorAll("[data-i18n-placeholder]");
      // @ts-ignore
      const data = window.I18N_DATA;
      if (data) {
         inputs.forEach((el: any) => {
            const key = el.getAttribute("data-i18n-placeholder");
            const val = key.split(".").reduce((o: any, i: any) => o?.[i], data);
            if (val) el.placeholder = val;
         });
      }
   }
   window.addEventListener("language-change", updatePlaceholders);
   document.addEventListener("DOMContentLoaded", updatePlaceholders);
   updatePlaceholders();

   // Slider Logic
   const sliderTrack = document.querySelector(
      "#demo-slider .slider-track",
   ) as HTMLElement;
   if (sliderTrack) {
      const slides = sliderTrack.querySelectorAll("img");
      const totalSlides = slides.length;
      let currentSlide = 0;

      function nextSlide() {
         currentSlide = (currentSlide + 1) % totalSlides;
         const offset = currentSlide * -100;
         sliderTrack.style.transform = `translateX(${offset}%)`;
      }

      // Auto slide every 3 seconds
      setInterval(nextSlide, 3000);
   }
</script>
